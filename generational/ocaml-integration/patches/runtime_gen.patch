+#endif
+/* Defined in verified_gc/alloc_gen.c. */
+extern void verified_do_minor_gc (void);
+/* The colour the verified allocator gives a major block whose header is at
+   [hp], at the collector's current phase (GC.Spec.Phase.allocation_color):
+   black mid-sweep at or above the sweep cursor, white otherwise. */
+extern color_t vergc_allocation_color (void *hp);
+/* Stock's major-GC entry points forward to these, so that no stock mark or
+   sweep ever runs over the verified heap: caml_major_collection_slice
+   (Gc.major_slice) to a sweep slice when the verified collector is mid-sweep;
+   Gc.major, Gc.full_major, Gc.compact and caml_finish_major_cycle (Gc.set's
+   policy change) to one whole verified collection. */
+extern void verified_major_collection_slice (intnat howmuch);
+extern void verified_do_full_gc (void);
+/* The verified write barrier, for a slot not in the nursery: caml_modify
+   (darken the old value while marking, write) and caml_initialize (write).
+   Each returns whether the caller must add the slot to the ref table. */
+extern int vergc_modify (value *fp, value val);
+extern int vergc_initialize (value *fp, value val);
+extern uint64_t *vergc_minor_bump_ref;
+extern uint8_t  *vergc_minor_base;
+extern uint64_t  vergc_minor_size;
+
+#ifndef WITH_PROFINFO
+#define VERGC_HP_IN_MINOR(hp)                                           \
+  (vergc_minor_base != NULL &&                                          \
+   (uintnat)(hp) >= (uintnat)vergc_minor_base &&                        \
+   (uintnat)(hp) - (uintnat)vergc_minor_base < (uintnat)vergc_minor_size)
+#define VERGC_SHOULD_WRITE_SMALL_HEADER(fast, hp)                       \
+  ((fast) || !VERGC_HP_IN_MINOR(hp))
+#else
+#define VERGC_SHOULD_WRITE_SMALL_HEADER(fast, hp) 1
+#endif
+
+#ifdef NATIVE_CODE
+/* Native code doesn't use this macro for allocations for most cases. 
+ * it is only called from other C files in 
+ * the runtime (weak.c, memprof.c etc)*/
 #define Alloc_small_aux(result, wosize, tag, profinfo, track) do {     \
   CAMLassert ((wosize) >= 1);                                          \
   CAMLassert ((tag_t) (tag) < 256);                                    \
@@ -233,6 +277,38 @@ extern void caml_alloc_small_dispatch (intnat wosize, int flags,
   (result) = Val_hp (Caml_state_field(young_ptr));                     \
   DEBUG_clear ((result), (wosize));                                    \
 }while(0)
+#else
+#define Alloc_small_aux(result, wosize, tag, profinfo, track) do {     \
+  value vergc_alloc_hp;                                                \
+  int vergc_fast_alloc = 0;                                            \
+  uint64_t vergc_needed =                                              \
+    (uint64_t) Whsize_wosize (wosize) * (uint64_t) sizeof(value);      \
+  CAMLassert ((wosize) >= 1);                                          \
+  CAMLassert ((tag_t) (tag) < 256);                                    \
+  CAMLassert ((wosize) <= Max_young_wosize);                           \
+  if (vergc_minor_bump_ref != NULL && vergc_minor_base != NULL) {      \
+    uint64_t vergc_bump = *vergc_minor_bump_ref;                       \
+    if (vergc_bump <= vergc_minor_size &&                               \
+        vergc_needed <= vergc_minor_size - vergc_bump) {               \
+      vergc_alloc_hp = (value)(vergc_minor_base + vergc_bump);         \
+      *vergc_minor_bump_ref = vergc_bump + vergc_needed;               \
+      vergc_fast_alloc = 1;                                            \
+    }                                                                  \
+  }                                                                    \
+  if (!vergc_fast_alloc) {                                             \
+    Setup_for_gc;                                                      \
+    vergc_alloc_hp =                                                   \
+      (value)verified_allocate_minor((wosize), (uint8_t)(tag));        \
+    Restore_after_gc;                                                  \
+  }                                                                    \
+  if (VERGC_SHOULD_WRITE_SMALL_HEADER(vergc_fast_alloc, vergc_alloc_hp)) {\
+    Hd_hp (vergc_alloc_hp) =                                           \
+      Make_header_with_profinfo ((wosize), (tag), 0, profinfo);        \
+  }                                                                    \
+  (result) = Val_hp (vergc_alloc_hp);                                  \
+  DEBUG_clear ((result), (wosize));                                    \
+}while(0)
+#endif
 
 #define Alloc_small_with_profinfo(result, wosize, tag, profinfo) \
   Alloc_small_aux(result, wosize, tag, profinfo, CAML_DO_TRACK)
