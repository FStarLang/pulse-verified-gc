-libcamlrun.$(A): $(libcamlrun_OBJECTS)
-	$(call MKLIB,$@, $^)
+# Verified GC: embed the verified collector's objects the same way
+# libasmrun.a does. The patched interp.c/memory.h in $(libcamlrun_OBJECTS)
+# reference vergc_minor_base / vergc_minor_bump_ref / vergc_minor_size /
+# verified_allocate_minor, which live in libvergc_gen.a. ocamlrun itself links
+# both archives explicitly, so it was fine -- but ANY `-custom` link (ocamlc
+# -custom, and hence ocamltest, which builds a custom runtime) links only
+# libcamlrun.a and failed with undefined references to those symbols.
+libcamlrun.$(A): $(libcamlrun_OBJECTS) libvergc_gen.a
+	rm -rf vergc_byte_objs
+	mkdir -p vergc_byte_objs
+	cd vergc_byte_objs && $(AR) x ../libvergc_gen.a
+	$(call MKLIB,$@, $(libcamlrun_OBJECTS) vergc_byte_objs/*.o)
+	rm -rf vergc_byte_objs
 
 libcamlrun_non_shared.$(A): $(libcamlrun_non_shared_OBJECTS)
 	$(call MKLIB,$@, $^)
 
