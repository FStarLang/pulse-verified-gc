 	$(call MKLIB,$@, $^)
 
-ocamlruni$(EXE): prims.$(O) libcamlruni.$(A)
+ocamlruni$(EXE): prims.$(O) libcamlruni.$(A) libvergc_gen.a
 	$(MKEXE) -o $@ $^ $(INSTRUMENTED_RUNTIME_LIBS) $(LIBS)
 
 libcamlruni.$(A): $(libcamlruni_OBJECTS)
@@ -298,8 +323,12 @@ libcamlrun_pic.$(A): $(libcamlrunpic_OBJECTS)
