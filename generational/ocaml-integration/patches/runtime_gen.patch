diff --git a/runtime/major_gc.c b/runtime/major_gc.c
index 3da350e..2ab9520 100644
--- a/runtime/major_gc.c
+++ b/runtime/major_gc.c
@@ -940,6 +940,17 @@ void caml_major_collection_slice (intnat howmuch)
   double p, dp, filt_p, spend;
   intnat computed_work;
   int i;
+
+  /* Verified GC: stock's major collector must never run. Its mark would
+     darken the verified heap's objects (that heap is In_heap in the page
+     table) and its sweep, which walks only stock's own chunks, would never
+     whiten them again, leaving black objects in an idle heap: the next
+     verified mark then skips their children and frees live objects. Every
+     caller (caml_gc_dispatch, Gc.major_slice) gets the verified collector's
+     slice instead: a sweep slice when it is mid-sweep, nothing otherwise. */
+  verified_major_collection_slice (howmuch);
+  return;
+
   /*
      Free memory at the start of the GC cycle (garbage + free list) (assumed):
                  FM = Caml_state->stat_heap_wsz * caml_percent_free
@@ -1177,6 +1188,14 @@ void caml_major_collection_slice (intnat howmuch)
 */
 void caml_finish_major_cycle (void)
 {
+  /* Verified GC: a whole verified cycle instead of a stock one (see
+     caml_major_collection_slice above). This is what Gc.full_major,
+     Gc.major, Gc.compact and Gc.set (policy change) reach. */
+  verified_finish_major_cycle ();
+  Caml_state->stat_major_words += caml_allocated_words;
+  caml_allocated_words = 0;
+  return;
+
   if (caml_gc_phase == Phase_idle){
     p_backlog = 0.0; /* full major GC cycle, the backlog becomes irrelevant */
     start_cycle ();
@@ -1280,6 +1299,12 @@ void caml_set_major_window (int w){
 
 void caml_finalise_heap (void)
 {
+  /* Verified GC: stock's forced sweep of its own chunks at shutdown
+     (OCAMLRUNPARAM=c) would first run a stock major cycle over the verified
+     heap. The verified heap is not finalised: custom-block finalisers are
+     not run (docs/known-issues.md). */
+  return;
+
   /* Finishing major cycle (all values become white) */
   caml_empty_minor_heap ();
   caml_gc_message (0x1, "Finishing major GC cycle (finalising heap)\n");
