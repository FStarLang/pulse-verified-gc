# Local SPOT verification build.
#
# Dependencies are generated by `fstar.exe --dep full` into .depend.  The
# generated file schedules the local SPOT interfaces/implementations in
# dependency order and records upstream GC source dependencies for
# invalidation.  Upstream GC modules are expected to be built by their own
# Makefiles/top-level build; this local campaign verifies only GC.SPOT.*.

FSTAR_HOME ?= ../fstar
FSTAR_EXE  ?= $(FSTAR_HOME)/bin/fstar.exe

INCLUDES = \
  --include . \
  --include ../common/spec --include ../common/lib --include ../common/impl \
  --include ../mark-and-sweep/spec --include ../mark-and-sweep/impl \
  --include ../generational/spec --include ../generational/impl

FSTAR_FLAGS = \
  --cache_checked_modules \
  --warn_error -321 \
  --report_assumes warn \
  --already_cached 'Prims FStar Pulse PulseCore GC -GC.SPOT' \
  $(INCLUDES)

FSTAR = $(FSTAR_EXE) $(FSTAR_FLAGS)

SPOT_SRC = \
  GC.SPOT.Layout.fsti \
  GC.SPOT.Layout.fst \
  GC.SPOT.ConcreteMinor.fsti \
  GC.SPOT.ConcreteMinor.fst \
  GC.SPOT.ConcreteMajor.fsti \
  GC.SPOT.ConcreteMajor.fst \
  GC.SPOT.Preconditions.fsti \
  GC.SPOT.Preconditions.fst \
  GC.SPOT.Postconditions.fsti \
  GC.SPOT.Postconditions.fst \
  GC.SPOT.ThreeObjects.fsti \
  GC.SPOT.ThreeObjects.fst \
  GC.SPOT.ConcreteForwarding.fsti \
  GC.SPOT.ConcreteForwarding.fst \
  GC.SPOT.ConcreteScenarios.fsti \
  GC.SPOT.ConcreteScenarios.fst \
  GC.SPOT.ConcreteFull.fsti \
  GC.SPOT.ConcreteFull.fst \
  GC.SPOT.CallMinor.fsti \
  GC.SPOT.CallMinor.fst \
  GC.SPOT.CallFull.fsti \
  GC.SPOT.CallFull.fst

SPOT_CHECKED = $(addsuffix .checked,$(SPOT_SRC))

COMMON_SRC = $(wildcard ../common/spec/*.fst ../common/spec/*.fsti \
                       ../common/lib/*.fst \
                       ../common/impl/*.fst ../common/impl/*.fsti)
MS_SRC     = $(wildcard ../mark-and-sweep/spec/*.fst ../mark-and-sweep/spec/*.fsti \
                       ../mark-and-sweep/impl/*.fst ../mark-and-sweep/impl/*.fsti)
GEN_SRC    = $(wildcard ../generational/spec/*.fst ../generational/spec/*.fsti \
                       ../generational/impl/*.fst ../generational/impl/*.fsti)
ALL_SRC    = $(SPOT_SRC) $(COMMON_SRC) $(MS_SRC) $(GEN_SRC)

.depend: Makefile $(ALL_SRC)
	$(FSTAR) --dep full $(SPOT_SRC) --output_deps_to $@.raw
	@awk -v cwd="$$(pwd)/" -v proj="$$(cd .. && pwd)/" ' \
	  { gsub(cwd, ""); gsub(proj, "../") } \
	  /^[^ \t].*:/ { flush(); split($$0, a, ":"); target = a[1]; \
	    keep = (target ~ /^GC\.SPOT\..*\.checked$$/); n = 0; \
	    if (keep) buf[n++] = target ": \\"; \
	    next } \
	  /^[A-Z_][A-Z0-9_]*[ \t]*=/ { flush(); keep = 0; n = 0; next } \
	  keep { line = $$0; sub(/^[ \t]+/, "", line); sub(/[ \t]*\\?[ \t]*$$/, "", line); \
	    if (line == "") next; \
	    if (line ~ /^GC\.SPOT\..*\.checked$$/) { buf[n++] = $$0; next } \
	    if (line ~ /^\.\.\/(common|mark-and-sweep|generational)\/.*\.(fst|fsti)\.checked$$/) { \
	      sub(/\.checked$$/, "", line); buf[n++] = "\t" line " \\"; next } \
	    if (line ~ /\.(fst|fsti)$$/) buf[n++] = $$0 } \
	  END { flush() } \
	  function flush() { if (!keep || n == 0) return; \
	    sub(/[ \t]*\\[ \t]*$$/, "", buf[n-1]); \
	    for (i=0;i<n;i++) print buf[i]; print ""; n=0 }' $@.raw > $@
	@rm -f $@.raw

.PHONY: all verify depend clean

all: verify

depend: .depend

-include .depend

verify: $(SPOT_CHECKED)
	@echo "=== SPOT modules verified ==="

GC.SPOT.%.fsti.checked: GC.SPOT.%.fsti
	$(FSTAR) --z3rlimit 10 --split_queries always $<

GC.SPOT.%.fst.checked: GC.SPOT.%.fst
	$(FSTAR) --z3rlimit 10 --split_queries always $<

clean:
	rm -f .depend .depend.raw *.checked
