{
  "fstar_exe": "fstar/bin/fstar.exe",
  "options": [
    "--cache_checked_modules",
    "--cache_dir", "_cache",
    "--retry", "3",
    "--z3smtopt", "(set-option :timeout 300000)",
    "--z3version", "4.15.3",
    "--warn_error", "-321",
    "--report_assumes", "warn",
    "--already_cached", "Prims FStar Pulse PulseCore -GC"
  ],
  "include_dirs": [
    "common/spec",
    "common/lib",
    "common/impl",
    "mark-and-sweep/spec",
    "mark-and-sweep/impl",
    "generational/spec",
    "generational/impl",
    "spot"
  ]
}